# ==============================================================================
# Gold N Glow - Environment Variables Template
# ==============================================================================
# In production on Vercel or locally, copy this file to .env and configure values.
# Vite requires all client-accessible variables to be prefixed with VITE_.
# ==============================================================================

# Supabase Cloud Database & Storage (Optional: Can also be linked via Admin CMS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Master Admin Credentials (Optional overrides)
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=
